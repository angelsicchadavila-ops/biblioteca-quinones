# Copia este archivo como .env y coloca allí tus valores reales.
# Nunca subas .env a GitHub.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST/BASE_DE_DATOS?sslmode=require
SECRET_KEY=GENERAR_UN_VALOR_ALEATORIO_LARGO_Y_PRIVADO
SESSION_COOKIE_SECURE=false

# Contraseñas locales para crear las cuentas admin_prueba y asistente_prueba.
# El inicializador guarda únicamente sus hashes en PostgreSQL.
SEED_ADMIN_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_DE_PRUEBA
SEED_ASISTENTE_PASSWORD=REEMPLAZAR_CON_UNA_CONTRASENA_DE_PRUEBA
